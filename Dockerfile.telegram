# Use official Bun image
FROM oven/bun:1 AS base

WORKDIR /app

# Copy workspace files
COPY package.json bun.lock ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY apps/telegram/package.json ./apps/telegram/

# Install dependencies
RUN bun install

# Copy source code
COPY apps/telegram ./apps/telegram

# Create data directory for session persistence
RUN mkdir -p /app/apps/telegram/data

# Set working directory
WORKDIR /app

# Start the Telegram bot
CMD ["bun", "run", "--filter", "@kindle-wrap/telegram", "start"]
