# Use official Bun image
FROM oven/bun:1 AS base

# Install Pandoc (pin to release version)
ARG PANDOC_VERSION=3.8.3
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    && wget -O /tmp/pandoc.deb "https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/pandoc-${PANDOC_VERSION}-1-$(dpkg --print-architecture).deb" \
    && apt-get install -y /tmp/pandoc.deb \
    && rm -f /tmp/pandoc.deb \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy workspace files
COPY package.json bun.lock ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

# Install dependencies
RUN bun install

# Copy source code
COPY apps/api ./apps/api

# Create output directory
RUN mkdir -p /app/apps/api/output

# Set working directory to api package
WORKDIR /app

# Expose port
EXPOSE 8080

# Start the API
CMD ["bun", "run", "--filter", "@bettersent/api", "start"]
