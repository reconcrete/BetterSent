{
  "name": "kindle-wrap",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "elysia": "1.4.20"
    }
  },
  "scripts": {
    "dev": "bun run --filter @kindle-wrap/* dev",
    "test": "bun run --filter @kindle-wrap/* test",
    "lint": "bun run --filter @kindle-wrap/* lint",

    "db:studio": "bun run --filter @kindle-wrap/api db:studio",

    "reinstall": "bun run clean && bun run install",
    "install": "bun install --filter @kindle-wrap/*",
    "clean": "rm -rf node_modules ./packages/*/node_modules"
  }
}
