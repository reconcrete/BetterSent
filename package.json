{
  "name": "bettersent",
  "private": true,
  "packageManager": "bun@1.3.3",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "elysia": "1.4.20"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "turbo lint",
    "build": "turbo build",
    "build:web": "turbo build --filter=@bettersent/web",

    "db:studio": "bun run --filter @bettersent/db db:studio",
    "db:generate": "bun run --filter @bettersent/db db:generate",
    "db:migrate": "bun run --filter @bettersent/db db:migrate",
    "db:push": "bun run --filter @bettersent/db db:push",

    "api:start": "bun run --filter @bettersent/api start",

    "reinstall": "bun run clean && bun install",
    "clean": "rm -rf node_modules ./apps/*/node_modules ./packages/*/node_modules .turbo ./apps/*/.turbo ./packages/*/.turbo"
  },
  "overrides": {
    "elysia": "1.4.20"
  },
  "devDependencies": {
    "turbo": "^2.8.10"
  },
  "trustedDependencies": [
    "@bettersent/extension"
  ]
}
