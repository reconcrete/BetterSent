---
const plans = [
  {
    name: "Free",
    price: "$0",
    description: "Get started with the essentials",
    features: [
      "5 extractions per month",
      "Send URLs, text, and files",
      "EPUB delivery to Kindle",
      "Multiple Kindle devices",
      "Telegram bot",
      "Send history",
    ],
    cta: "Get started",
    highlighted: false,
  },
  {
    name: "Pro",
    price: "$4.99",
    description: "For serious readers who want it all",
    features: [
      "500 extractions per month",
      "Everything in Free",
      "YouTube transcript extraction",
      "AI topic generation (50/mo)",
    ],
    cta: "Upgrade to Pro",
    highlighted: true,
  },
];
---

<section
  id="pricing"
  class="border-t border-border px-6 py-[120px] lg:px-[60px]"
>
  <div class="mx-auto max-w-[1352px]">
    <!-- Section header -->
    <div class="mb-16 text-center">
      <p
        data-animate
        class="text-[13px] font-semibold uppercase tracking-[2px] text-secondary dark:text-primary"
      >
        Pricing
      </p>
      <h2
        data-animate
        data-delay="1"
        class="mt-4 font-display text-4xl leading-[1.15] tracking-[-1px] text-foreground md:text-[48px] md:leading-[55.2px]"
      >
        Simple, transparent pricing
      </h2>
      <p
        data-animate
        data-delay="2"
        class="mx-auto mt-4 max-w-[440px] text-base leading-[27.2px] text-muted-foreground"
      >
        Start free. Upgrade when you need more. No hidden fees.
      </p>
    </div>

    <!-- Pricing cards -->
    <div
      class="mx-auto grid max-w-[800px] gap-6 md:grid-cols-2"
    >
      {
        plans.map((plan, i) => (
          <div
            data-animate
            data-delay={String(i + 1)}
            class:list={[
              "rounded-2xl border p-8 md:p-10",
              plan.highlighted
                ? "border-primary/30 bg-primary/5 ring-1 ring-primary/20"
                : "border-border bg-card",
            ]}
          >
            {plan.highlighted && (
              <span class="mb-4 inline-block rounded-full bg-primary/10 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.5px] text-secondary dark:bg-accent dark:text-primary">
                Most popular
              </span>
            )}
            <h3 class="text-xl font-bold text-foreground">{plan.name}</h3>
            <div class="mt-2 flex items-baseline gap-1">
              <span class="font-display text-[48px] leading-none tracking-[-1px] text-foreground">
                {plan.price}
              </span>
              <span class="text-sm text-muted-foreground">/month</span>
            </div>
            <p class="mt-2 text-sm text-muted-foreground">{plan.description}</p>

            <a
              href="https://app.bettersent.com/sign-in"
              class:list={[
                "mt-8 block rounded-[10px] py-3.5 text-center text-sm font-semibold transition-all",
                plan.highlighted
                  ? "bg-primary text-primary-foreground hover:brightness-110"
                  : "border border-border bg-muted text-foreground hover:bg-accent",
              ]}
            >
              {plan.cta}
            </a>

            <ul class="mt-8 space-y-3.5">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-3 text-sm text-muted-foreground">
                  <svg
                    class="mt-0.5 size-4 shrink-0 text-secondary dark:text-primary"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="3.5 8 6.5 11 12.5 5" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
