---
const recentItems = [
  {
    title: "Why AI Will Transform Reading",
    source: "paulgraham.com",
    gradient: "from-[#4f39f6] to-[#7f22fe]",
  },
  {
    title: "The Future of Digital Publishing",
    source: "stratechery.com",
    gradient: "from-[#009966] to-[#00d492]",
  },
  {
    title: "Building Better Reading Habits",
    source: "jamesclear.com",
    gradient: "from-[#e7000b] to-[#fe9a00]",
  },
];

const tabs = [
  { label: "File", active: false },
  { label: "Link", active: true },
  { label: "Plain Text", active: false },
  { label: "YouTube", active: false, pro: true },
  { label: "Topic", active: false, pro: true },
];
---

<div
  class="mx-auto max-w-[1000px] overflow-hidden rounded-2xl border border-[rgba(255,255,255,0.08)] bg-[#111314]"
>
  <!-- Window chrome -->
  <div
    class="flex h-11 items-center gap-2 border-b border-border bg-[#111314] px-4"
  >
    <span class="size-2.5 rounded-full bg-[#ff5f57]"></span>
    <span class="size-2.5 rounded-full bg-[#febc2e]"></span>
    <span class="size-2.5 rounded-full bg-[#28c840]"></span>
  </div>

  <!-- App content -->
  <div class="px-6 pt-8 pb-0 md:px-10">
    <!-- Main content -->
    <div class="flex flex-col gap-6">
      <!-- Header -->
      <div class="text-center">
        <h3 class="text-lg font-bold text-white">Send to Kindle</h3>
        <p class="text-[13px] text-muted-foreground">
          Choose a source and send it to your device
        </p>
      </div>

      <!-- Tabs -->
      <div class="flex items-center gap-1 overflow-x-auto rounded-xl border border-border bg-[rgba(255,255,255,0.02)] p-1.5">
        {
          tabs.map((tab) => (
            <div
              class:list={[
                "flex shrink-0 items-center gap-1.5 rounded-lg px-4 py-2.5 text-[13px] font-medium",
                tab.active
                  ? "bg-accent text-primary"
                  : "text-muted-foreground",
              ]}
            >
              {tab.label}
              {tab.pro && (
                <span class="rounded bg-[rgba(255,242,124,0.15)] px-1.5 py-0.5 text-[9px] font-bold uppercase text-primary">
                  Pro
                </span>
              )}
            </div>
          ))
        }
      </div>

      <!-- Input form -->
      <div
        class="rounded-xl border border-border bg-[rgba(255,255,255,0.03)] p-5"
      >
        <div class="flex gap-3">
          <div
            class="flex h-[45px] flex-1 items-center rounded-lg border border-border bg-[rgba(255,255,255,0.04)] px-4"
          >
            <span class="text-sm text-[#555]"
              >https://example.com/article...</span
            >
          </div>
          <button
            class="h-[45px] rounded-lg bg-primary px-5 text-sm font-semibold text-primary-foreground"
          >
            Send
          </button>
        </div>
        <!-- Device selector -->
        <div class="mt-4 flex items-center gap-3">
          <span class="text-xs text-[#555]">Device:</span>
          <span
            class="flex items-center gap-1.5 rounded-lg border border-primary/30 bg-accent px-3 py-1.5 text-xs font-medium text-primary"
          >
            <span class="size-3 rounded border border-primary/40 bg-primary/20 flex items-center justify-center">
              <span class="text-[8px] text-primary">✓</span>
            </span>
            My Kindle Paperwhite
          </span>
        </div>
      </div>

      <!-- Recent items -->
      <div>
        <p class="text-[13px] font-semibold text-[#a3a3a6]">Recent sends</p>
        <div class="mt-3 flex flex-col">
          {
            recentItems.map((item, i) => (
              <div
                class:list={[
                  "flex items-center gap-3 py-4",
                  i < recentItems.length - 1
                    ? "border-b border-[rgba(255,255,255,0.04)]"
                    : "",
                ]}
              >
                <div
                  class={`h-[50px] w-9 shrink-0 rounded bg-gradient-to-br ${item.gradient}`}
                />
                <div class="min-w-0 flex-1">
                  <p class="truncate text-[13px] font-semibold text-secondary-foreground">
                    {item.title}
                  </p>
                  <p class="text-[11.5px] text-muted-foreground">
                    {item.source}
                  </p>
                </div>
                <span class="shrink-0 text-[11px] font-semibold text-primary">
                  Delivered
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>
