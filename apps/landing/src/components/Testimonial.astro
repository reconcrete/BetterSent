---

<section class="px-6 py-[120px] lg:px-11">
  <div
    data-animate
    class="mx-auto flex max-w-[760px] flex-col items-center gap-10"
  >
    <!-- Quote -->
    <blockquote
      class="text-center font-display text-2xl italic leading-[46.4px] tracking-[-0.3px] text-secondary-foreground md:text-[32px]"
    >
      "Bettersent completely changed how I consume articles. I used to have <span
        class="text-primary">50 open tabs</span
      > — now everything goes straight to my Kindle. I actually finish reading
      things now."
    </blockquote>

    <!-- Author -->
    <div class="flex items-center gap-3">
      <div
        class="flex size-10 items-center justify-center rounded-full bg-[rgba(255,242,124,0.15)]"
      >
        <span class="text-sm font-bold text-primary">MK</span>
      </div>
      <div>
        <p class="text-sm font-semibold text-white">Maria Kowalski</p>
        <p class="text-[13px] text-muted-foreground">
          Software Engineer, reads 40+ articles/week
        </p>
      </div>
    </div>
  </div>
</section>
