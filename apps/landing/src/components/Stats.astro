---
const highlights = [
  { value: "5", label: "Content types", detail: "URLs, text, files, YouTube, AI topics" },
  { value: "EPUB", label: "Delivery format", detail: "Optimized for Kindle e-ink displays" },
  { value: "3", label: "Ways to send", detail: "Web app, Telegram bot, or file upload" },
  { value: "Free", label: "To get started", detail: "5 sends per month, no credit card" },
];
---

<section class="px-6 py-10 lg:px-[60px]">
  <div
    data-animate
    class="mx-auto flex max-w-[1352px] flex-wrap items-center justify-around gap-8 rounded-[20px] border border-[rgba(255,242,124,0.15)] bg-accent px-12 py-16 md:py-[60px]"
  >
    {
      highlights.map((item) => (
        <div class="text-center">
          <p class="font-display text-4xl leading-[56px] tracking-[-1px] text-primary md:text-[56px]">
            {item.value}
          </p>
          <p class="text-sm font-medium text-white">{item.label}</p>
          <p class="mt-1 text-xs text-muted-foreground">{item.detail}</p>
        </div>
      ))
    }
  </div>
</section>
