---
const steps = [
  {
    number: "01",
    title: "Paste a link or upload a file",
    description:
      "Drop in any URL — articles, blog posts, research papers. Or upload PDFs and EPUBs directly. We accept it all.",
  },
  {
    number: "02",
    title: "We format it for your Kindle",
    description:
      "Our engine strips away clutter, extracts the content, and reformats it into a beautiful EPUB for your e-reader.",
  },
  {
    number: "03",
    title: "Read on your device",
    description:
      "Your content arrives on your Kindle as a formatted EPUB. Open it up and enjoy distraction-free reading anywhere.",
  },
];
---

<section
  id="how-it-works"
  class="border-t border-[rgba(255,255,255,0.04)] px-6 py-[120px] lg:px-[60px]"
>
  <div class="mx-auto max-w-[1352px]">
    <!-- Section header -->
    <div class="mb-20 max-w-[559px]">
      <p
        data-animate
        class="text-[13px] font-semibold uppercase tracking-[2px] text-primary"
      >
        How it works
      </p>
      <h2
        data-animate
        data-delay="1"
        class="mt-4 font-display text-4xl leading-[1.15] tracking-[-1px] text-white md:text-[48px] md:leading-[55.2px]"
      >
        From browser to Kindle in three steps
      </h2>
      <p
        data-animate
        data-delay="2"
        class="mt-4 text-base leading-[27.2px] text-muted-foreground"
      >
        Three simple steps. No technical skills needed.
      </p>
    </div>

    <!-- Steps -->
    <div class="grid gap-10 md:grid-cols-3 md:gap-10">
      {
        steps.map((step, i) => (
          <div data-animate data-delay={String(i + 1)}>
            <p class="font-display text-[72px] leading-[72px] text-[rgba(255,242,124,0.1)]">
              {step.number}
            </p>
            <h3 class="mt-4 text-lg font-bold text-white">{step.title}</h3>
            <p class="mt-3 max-w-[401px] text-sm leading-[23.1px] text-muted-foreground">
              {step.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
