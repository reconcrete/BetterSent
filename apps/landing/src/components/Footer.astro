---
const columns = [
  {
    title: "Product",
    links: [
      { label: "Features", href: "#features" },
      { label: "Pricing", href: "#pricing" },
      { label: "FAQ", href: "#faq" },
    ],
  },
  {
    title: "Legal",
    links: [
      { label: "Privacy", href: "#" },
      { label: "Terms", href: "#" },
    ],
  },
];
---

<footer class="border-t border-border px-6 lg:px-[60px]">
  <div class="mx-auto max-w-[1352px]">
    <!-- Main footer -->
    <div
      class="flex flex-col gap-12 pb-10 pt-14 md:flex-row md:items-start md:justify-between"
    >
      <!-- Brand -->
      <div class="max-w-[280px]">
        <a href="/" class="flex items-baseline gap-[3px] select-none">
          <span
            class="font-display text-[18px] leading-[28px] italic text-secondary dark:text-primary"
            >better</span
          >
          <span
            class="text-[18px] font-extrabold leading-[28px] lowercase text-foreground"
            >sent</span
          >
        </a>
        <p class="mt-3 text-[13px] leading-[20.8px] text-muted-foreground">
          Send articles, documents, and books to your Kindle with one click.
          Read everything in one place.
        </p>
      </div>

      <!-- Link columns -->
      <div class="flex gap-16">
        {
          columns.map((col) => (
            <div>
              <p class="text-xs font-bold uppercase tracking-[1px] text-muted-foreground">
                {col.title}
              </p>
              <ul class="mt-4 space-y-2.5">
                {col.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-[13.5px] text-muted-foreground transition-colors hover:text-foreground"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="flex items-center justify-center border-t border-border py-5"
    >
      <p class="text-xs text-muted-foreground">
        &copy; {new Date().getFullYear()} Bettersent. All rights reserved.
      </p>
    </div>
  </div>
</footer>
