---
const columns = [
  {
    title: "Product",
    links: [
      { label: "Features", href: "#features" },
      { label: "Pricing", href: "#pricing" },
      { label: "Telegram Bot", href: "#" },
      { label: "API", href: "#" },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "Help Center", href: "#" },
      { label: "Changelog", href: "#" },
      { label: "Status", href: "#" },
    ],
  },
  {
    title: "Company",
    links: [
      { label: "About", href: "#" },
      { label: "Privacy", href: "#" },
      { label: "Terms", href: "#" },
    ],
  },
];

const socials = [
  { label: "Twitter", href: "#" },
  { label: "GitHub", href: "#" },
];
---

<footer class="border-t border-border px-6 lg:px-[60px]">
  <div class="mx-auto max-w-[1352px]">
    <!-- Main footer -->
    <div
      class="flex flex-col gap-12 pb-10 pt-14 md:flex-row md:items-start md:justify-between"
    >
      <!-- Brand -->
      <div class="max-w-[280px]">
        <a href="/" class="flex items-baseline gap-[3px] select-none">
          <span
            class="font-display text-[18px] leading-[28px] italic text-primary"
            >better</span
          >
          <span
            class="text-[18px] font-extrabold leading-[28px] lowercase text-white"
            >sent</span
          >
        </a>
        <p class="mt-3 text-[13px] leading-[20.8px] text-muted-foreground">
          Send articles, documents, and books to your Kindle with one click.
          Read everything in one place.
        </p>
      </div>

      <!-- Link columns -->
      <div class="flex gap-16">
        {
          columns.map((col) => (
            <div>
              <p class="text-xs font-bold uppercase tracking-[1px] text-[#555]">
                {col.title}
              </p>
              <ul class="mt-4 space-y-2.5">
                {col.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-[13.5px] text-muted-foreground transition-colors hover:text-secondary-foreground"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="flex flex-col items-center justify-between gap-4 border-t border-[rgba(255,255,255,0.04)] py-5 md:flex-row"
    >
      <p class="text-xs text-[#555]">
        &copy; {new Date().getFullYear()} Bettersent. All rights reserved.
      </p>
      <div class="flex gap-4">
        {
          socials.map((s) => (
            <a
              href={s.href}
              class="text-[13px] text-[#555] transition-colors hover:text-muted-foreground"
            >
              {s.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
