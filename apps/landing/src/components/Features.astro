---
const features = [
  {
    title: "Every format, finally",
    description:
      "Markdown, MOBI, FB2, EPUB, PDF, DOCX — we convert them all into something your Kindle will actually accept. No more 'unsupported file type'.",
    icon: "formats",
  },
  {
    title: "PDFs that read like books",
    description:
      "Kindle's native PDF handling is unreadable on e-ink. We reflow the text, preserve structure, and strip the cruft so it feels like a real book.",
    icon: "pdf",
  },
  {
    title: "Articles without the clutter",
    description:
      "Paste a URL to any article or blog post. We scrape it cleanly, convert to Markdown, and deliver the content — no ads, no sidebars, no popups.",
    icon: "article",
  },
  {
    title: "Code blocks that work",
    description:
      "Send an EPUB with code and Amazon's pipeline mangles it into unreadable soup. We preserve formatting, indentation, and fonts so code stays legible.",
    icon: "code",
  },
  {
    title: "AI-generated mini-books",
    description:
      "Type a topic. Our AI researches, outlines, and writes a full mini-book on it — delivered to your Kindle, ready to read.",
    icon: "ai",
    pro: true,
  },
  {
    title: "YouTube transcriptions",
    description:
      "Paste any YouTube link. We pull the full transcript and send it as a clean, readable document — perfect for long lectures and interviews.",
    icon: "youtube",
    pro: true,
  },
];
---

<section id="features" class="border-t border-border px-6 py-[120px] lg:px-[60px]">
  <div class="mx-auto max-w-[1352px]">
    <!-- Section header -->
    <div class="mb-16 max-w-[516px]">
      <p
        data-animate
        class="text-[13px] font-semibold uppercase tracking-[2px] text-secondary dark:text-primary"
      >
        Features
      </p>
      <h2
        data-animate
        data-delay="1"
        class="mt-4 font-display text-4xl leading-[1.15] tracking-[-1px] text-foreground md:text-[48px] md:leading-[55.2px]"
      >
        Everything you need to read on your terms
      </h2>
      <p
        data-animate
        data-delay="2"
        class="mt-6 max-w-[355px] text-base leading-[27.2px] text-muted-foreground"
      >
        Send anything to your Kindle with zero friction. We handle the
        formatting so you can focus on reading.
      </p>
    </div>

    <!-- Feature grid -->
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature, i) => (
          <div
            data-animate
            data-delay={String(Math.min(i + 1, 5))}
            class="group rounded-2xl border border-border bg-card p-8 transition-colors hover:border-primary/30 hover:bg-accent/50"
          >
            {/* Icon */}
            <div class="mb-6 flex size-11 items-center justify-center rounded-xl bg-primary/10 dark:bg-accent">
              {feature.icon === "formats" && (
                <svg
                  class="size-5 text-secondary dark:text-primary"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M3.5 5.5h6l2 2h5a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1h-13a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1z" />
                  <path d="M7 11.5h6" />
                  <path d="M7 14h4" />
                </svg>
              )}
              {feature.icon === "pdf" && (
                <svg
                  class="size-5 text-secondary dark:text-primary"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7l-5-5z" />
                  <polyline points="12 2 12 7 17 7" />
                  <path d="M6 11.5h8" />
                  <path d="M6 14h6" />
                </svg>
              )}
              {feature.icon === "article" && (
                <svg
                  class="size-5 text-secondary dark:text-primary"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="2.5" y="3.5" width="15" height="13" rx="1.5" />
                  <path d="M2.5 7.5h15" />
                  <path d="M5.5 11h5" />
                  <path d="M5.5 13.5h7" />
                  <path d="M13 11h1.5" />
                  <path d="M13 13.5h1.5" />
                </svg>
              )}
              {feature.icon === "code" && (
                <svg
                  class="size-5 text-secondary dark:text-primary"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="6.5 7 3 10 6.5 13" />
                  <polyline points="13.5 7 17 10 13.5 13" />
                  <line x1="11.5" y1="5" x2="8.5" y2="15" />
                </svg>
              )}
              {feature.icon === "ai" && (
                <svg
                  class="size-5 text-secondary dark:text-primary"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M10 2.5l1.3 3.5 3.5 1.3-3.5 1.3L10 12l-1.3-3.4L5.2 7.3l3.5-1.3z" />
                  <path d="M15 12.5l.7 1.8 1.8.7-1.8.7L15 17.5l-.7-1.8-1.8-.7 1.8-.7z" />
                </svg>
              )}
              {feature.icon === "youtube" && (
                <svg
                  class="size-5 text-secondary dark:text-primary"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M2.5 14a20 20 0 0 1 0-8 1.5 1.5 0 0 1 1.05-1.05 41 41 0 0 1 12.9 0A1.5 1.5 0 0 1 17.5 6a20 20 0 0 1 0 8 1.5 1.5 0 0 1-1.05 1.05 41 41 0 0 1-12.9 0A1.5 1.5 0 0 1 2.5 14" />
                  <path d="m8.5 12.5 4-2.5-4-2.5z" fill="currentColor" />
                </svg>
              )}
            </div>

            {/* Content */}
            <div class="flex items-center gap-2">
              <h3 class="text-[17px] font-bold tracking-[-0.2px] text-foreground">
                {feature.title}
              </h3>
              {feature.pro && (
                <span class="rounded-md bg-primary/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.5px] text-secondary dark:bg-accent dark:text-primary">
                  Pro
                </span>
              )}
            </div>
            <p class="mt-3 max-w-[335px] text-sm leading-[23.1px] text-muted-foreground">
              {feature.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
