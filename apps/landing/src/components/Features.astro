---
const features = [
  {
    title: "One-click send",
    description:
      "Paste any URL and hit send. Articles, blog posts, research papers — delivered to your Kindle in seconds.",
    icon: "link",
  },
  {
    title: "Smart formatting",
    description:
      "We strip away web clutter automatically. No ads, no sidebars — just the content, perfectly formatted for e-ink.",
    icon: "sparkles",
  },
  {
    title: "PDF & EPUB support",
    description:
      "Upload PDFs, EPUBs, DOCX, and more. Files up to 200MB, optimized and delivered instantly.",
    icon: "file",
  },
  {
    title: "YouTube transcripts",
    description:
      "Paste a YouTube URL. We extract the full transcript and send it as a readable document to your Kindle.",
    icon: "play",
    pro: true,
  },
  {
    title: "AI topic generation",
    description:
      "Enter any topic. Our AI generates a comprehensive mini-book — research, structure, and all — sent to your Kindle.",
    icon: "ai",
    pro: true,
  },
  {
    title: "Telegram bot",
    description:
      "Send content from Telegram. Forward a link or text to our bot and it lands on your Kindle without opening a browser.",
    icon: "telegram",
    free: true,
  },
];
---

<section id="features" class="border-t border-[rgba(255,255,255,0.04)] px-6 py-[120px] lg:px-[60px]">
  <div class="mx-auto max-w-[1352px]">
    <!-- Section header -->
    <div class="mb-16 max-w-[516px]">
      <p
        data-animate
        class="text-[13px] font-semibold uppercase tracking-[2px] text-primary"
      >
        Features
      </p>
      <h2
        data-animate
        data-delay="1"
        class="mt-4 font-display text-4xl leading-[1.15] tracking-[-1px] text-white md:text-[48px] md:leading-[55.2px]"
      >
        Everything you need to read on your terms
      </h2>
      <p
        data-animate
        data-delay="2"
        class="mt-6 max-w-[355px] text-base leading-[27.2px] text-muted-foreground"
      >
        Send anything to your Kindle with zero friction. We handle the
        formatting so you can focus on reading.
      </p>
    </div>

    <!-- Feature grid -->
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature, i) => (
          <div
            data-animate
            data-delay={String(Math.min(i + 1, 5))}
            class="group rounded-2xl border border-border bg-[rgba(255,255,255,0.02)] p-8 transition-colors hover:border-[rgba(255,255,255,0.12)] hover:bg-[rgba(255,255,255,0.04)]"
          >
            {/* Icon */}
            <div class="mb-6 flex size-11 items-center justify-center rounded-xl bg-accent">
              {feature.icon === "link" && (
                <svg
                  class="size-5 text-primary"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                >
                  <path d="M8.5 11.5a4 4 0 0 0 5.66 0l2-2a4 4 0 0 0-5.66-5.66l-1 1" />
                  <path d="M11.5 8.5a4 4 0 0 0-5.66 0l-2 2a4 4 0 0 0 5.66 5.66l1-1" />
                </svg>
              )}
              {feature.icon === "sparkles" && (
                <svg
                  class="size-5 text-primary"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M10 2l1.5 4.5L16 8l-4.5 1.5L10 14l-1.5-4.5L4 8l4.5-1.5L10 2z" />
                  <path d="M15 12l.75 2.25L18 15l-2.25.75L15 18l-.75-2.25L12 15l2.25-.75L15 12z" />
                </svg>
              )}
              {feature.icon === "file" && (
                <svg
                  class="size-5 text-primary"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7l-5-5z" />
                  <polyline points="12 2 12 7 17 7" />
                  <line x1="7" y1="10" x2="13" y2="10" />
                  <line x1="7" y1="13" x2="11" y2="13" />
                </svg>
              )}
              {feature.icon === "play" && (
                <svg
                  class="size-5 text-primary"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="10" cy="10" r="8" />
                  <polygon points="8 6.5 14 10 8 13.5" fill="currentColor" />
                </svg>
              )}
              {feature.icon === "ai" && (
                <svg
                  class="size-5 text-primary"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M10 2v2M10 16v2M4.93 4.93l1.41 1.41M13.66 13.66l1.41 1.41M2 10h2M16 10h2M4.93 15.07l1.41-1.41M13.66 6.34l1.41-1.41" />
                  <circle cx="10" cy="10" r="3" />
                </svg>
              )}
              {feature.icon === "telegram" && (
                <svg
                  class="size-5 text-primary"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                >
                  <path d="M18.384 2.492a1.21 1.21 0 0 0-1.232-.175L2.434 8.255a1.21 1.21 0 0 0 .1 2.254l3.586 1.16 1.394 4.45a.808.808 0 0 0 1.361.33l2.002-2.035 3.59 2.647a1.21 1.21 0 0 0 1.894-.783l2.14-12.584a1.21 1.21 0 0 0-.117-.802zM8.29 12.533l-.398 2.686-1.155-3.692L14.7 6.058 8.29 12.533z" />
                </svg>
              )}
            </div>

            {/* Content */}
            <div class="flex items-center gap-2">
              <h3 class="text-[17px] font-bold tracking-[-0.2px] text-white">
                {feature.title}
              </h3>
              {feature.pro && (
                <span class="rounded-md bg-[rgba(255,242,124,0.15)] px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.5px] text-primary">
                  Pro
                </span>
              )}
              {feature.free && (
                <span class="rounded-md bg-[rgba(255,255,255,0.08)] px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.5px] text-muted-foreground">
                  Free
                </span>
              )}
            </div>
            <p class="mt-3 max-w-[335px] text-sm leading-[23.1px] text-muted-foreground">
              {feature.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
