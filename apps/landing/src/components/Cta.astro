---

---

<section
  class="border-t border-border px-6 py-[120px] lg:px-7"
>
  <div class="mx-auto flex max-w-[1352px] flex-col items-center gap-10">
    <div data-animate class="text-center">
      <h2
        class="font-display text-4xl leading-[1.1] tracking-[-1.5px] text-foreground md:text-[56px] md:leading-[61.6px]"
      >
        Ready to read<br />
        <em class="italic text-secondary dark:text-primary">without
          distractions?</em>
      </h2>
      <p
        class="mx-auto mt-4 max-w-[416px] text-base leading-[27.2px] text-muted-foreground md:text-[17px]"
      >
        Free for your first 5 sends. No credit card required. Takes less than 60
        seconds to set up.
      </p>
    </div>

    <div data-animate data-delay="1" class="flex items-center gap-3">
      <a
        href="https://app.bettersent.com/sign-in"
        class="flex items-center gap-2.5 rounded-[10px] bg-primary px-8 py-[14px] text-[15px] font-semibold text-primary-foreground transition-all hover:brightness-110"
      >
        <svg
          class="size-4"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M14 10v3a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-3"></path>
          <polyline points="5 6 8 3 11 6"></polyline>
          <line x1="8" y1="3" x2="8" y2="11"></line>
        </svg>
        Get started for free
      </a>
      <a
        href="#pricing"
        class="rounded-[10px] border border-border bg-muted px-8 py-[14px] text-[15px] font-medium text-foreground transition-colors hover:bg-accent"
      >
        View pricing
      </a>
    </div>
  </div>
</section>
