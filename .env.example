# Copy to .env and fill in. Compose reads this file automatically.

WEB_URL=https://bettersent.holod.dev
API_URL=https://bettersent-api.holod.dev

# Must match the major version of the database the dump came from, or be newer.
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=bettersent

# Reuse the value from Railway — changing it invalidates every live session.
BETTER_AUTH_SECRET=

# Google Cloud Console -> Credentials. The authorised redirect URI must include
# https://bettersent-api.holod.dev/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared secret between the API and the Telegram bot. Must be identical in both.
INTERNAL_API_KEY=

OPENAI_API_KEY=
DEFUDDLE_API_KEY=
FIRECRAWL_API_KEY=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

BOT_TOKEN=

# Local MinIO, not AWS. These become both the MinIO root credentials and the
# API's AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=bettersent
S3_REGION=us-east-1
S3_PREFIX=extract

# Billing is unused self-hosted, but stripe-node constructs at import time and
# rejects an empty key, so the placeholder has to stay syntactically valid.
STRIPE_SECRET_KEY=sk_test_unused
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

LOG_LEVEL=info

# Optional analytics. Leave blank to disable.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=
